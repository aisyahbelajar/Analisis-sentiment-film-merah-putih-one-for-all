        "\n",
        "class OptimizedManualSVM:\n",
        "    def __init__(self, learning_rate=0.001, lambda_param=0.01, n_epochs=3000,\n",
        "                 batch_size=32, early_stopping_patience=100):\n",
        "        self.lr = learning_rate\n",
        "        self.lambda_param = lambda_param\n",
        "        self.n_epochs = n_epochs\n",
        "        self.batch_size = batch_size\n",
        "        self.early_stopping_patience = early_stopping_patience\n",
        "        self.weights = None\n",
        "        self.bias = None\n",
        "        self.loss_history = []\n",
        "        self.val_loss_history = []\n",
        "\n",
        "    def _create_mini_batches(self, X, y):\n",
        "        indices = np.random.permutation(len(X))\n",
        "        X_shuffled = X[indices]\n",
        "        y_shuffled = y[indices]\n",
        "\n",
        "        mini_batches = []\n",
        "        n_batches = len(X) // self.batch_size\n",
        "\n",
        "        for i in range(n_batches):\n",
        "            start = i * self.batch_size\n",
        "            end = start + self.batch_size\n",
        "            mini_batches.append((X_shuffled[start:end], y_shuffled[start:end]))\n",
        "\n",
        "        if len(X) % self.batch_size != 0:\n",
        "            mini_batches.append((X_shuffled[n_batches*self.batch_size:],\n",
        "                               y_shuffled[n_batches*self.batch_size:]))\n",
        "\n",
        "        return mini_batches\n",
        "\n",
        "    def _compute_loss(self, X, y):\n",
        "        n_samples = len(y)\n",
        "        distances = 1 - y * (np.dot(X, self.weights) - self.bias)\n",
        "        distances[distances < 0] = 0\n",
        "        hinge_loss = np.sum(distances) / n_samples\n",
        "        reg_loss = self.lambda_param * np.sum(self.weights ** 2)\n",
        "        return hinge_loss + reg_loss\n",
        "\n",
        "    def fit(self, X_train, y_train, X_val=None, y_val=None):\n",
        "        n_samples, n_features = X_train.shape\n",
        "\n",
        "        y_train_converted = np.where(y_train <= 0, -1, 1)\n",
        "        if X_val is not None:\n",
        "            y_val_converted = np.where(y_val <= 0, -1, 1)\n",
        "\n",
        "        np.random.seed(42)\n",
        "        self.weights = np.random.randn(n_features) * np.sqrt(2.0 / n_features)\n",
        "        self.bias = 0\n",
        "\n",
        "        print(f\"\\n🚀 Memulai training dengan {self.n_epochs} epochs...\")\n",
        "        print(f\"   Batch size: {self.batch_size}\")\n",
        "        print(f\"   Learning rate: {self.lr}\")\n",
        "        print(f\"   Lambda: {self.lambda_param}\")\n",
        "\n",
        "        best_val_loss = float('inf')\n",
        "        patience_counter = 0\n",
        "        best_weights = None\n",
        "        best_bias = None\n",
        "        initial_lr = self.lr\n",
        "\n",
        "        for epoch in range(self.n_epochs):\n",
        "            self.lr = initial_lr * (1 + np.cos(np.pi * epoch / self.n_epochs)) / 2\n",
        "            mini_batches = self._create_mini_batches(X_train, y_train_converted)\n",
        "\n",
        "            for X_batch, y_batch in mini_batches:\n",
        "                batch_size = len(y_batch)\n",
        "                predictions = np.dot(X_batch, self.weights) - self.bias\n",
        "                misclassified = y_batch * predictions < 1\n",
        "\n",
        "                dw = 2 * self.lambda_param * self.weights\n",
        "                db = 0\n",
        "\n",
        "                if np.sum(misclassified) > 0:\n",
